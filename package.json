{
  "name": "aquascope-vscode-extension",
  "displayName": "Aquascope",
  "description": "VS Code extension for Aquascope.",
  "version": "0.0.4",
  "publisher": "jackpham",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phamquy/aquascope-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "aquascope.hello",
        "title": "Aquascope: Hello"
      },
      {
        "command": "aquascope.analyzeAtCursor",
        "title": "Aquascope: Analyze Function at Cursor",
        "icon": "$(eye)"
      },
      {
        "command": "aquascope.showStackAndHeap",
        "title": "Aquascope: Show Stack and Heap"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aquascope.analyzeAtCursor",
          "when": "editorLangId == rust"
        },
        {
          "command": "aquascope.showStackAndHeap",
          "when": "editorLangId == rust"
        }
      ],
      "editor/title": [
        {
          "command": "aquascope.analyzeAtCursor",
          "when": "resourceLangId == rust",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Aquascope",
      "properties": {
        "aquascope.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Aquascope."
        },
        "aquascope.toolchainPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder holding the Aquascope tools and the pinned Rust toolchain: `bin/cargo-aquascope`, `bin/aquascope-driver` and `toolchain/`. Leave empty to use the copy shipped with the extension. Read from user settings only, so a workspace cannot point the extension at other programs."
        },
        "aquascope.analysisTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 5,
          "markdownDescription": "Seconds an analysis may run before it is stopped. The run can also be cancelled from its progress notification."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run compile && tsc -p tsconfig.test.json && node out/test/runTest.js",
    "package": "bash scripts/package-platform.sh",
    "vscode:prepublish": "node esbuild.mjs --production",
    "task": "node scripts/task.mjs",
    "dev-bundle": "node scripts/dev-bundle.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "mocha": "^10.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
