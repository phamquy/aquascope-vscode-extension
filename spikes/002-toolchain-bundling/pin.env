# Pinned Aquascope version for the bundling spike (T-004). Sourced by the spike scripts.
# The binaries are built from a fork: upstream v0.4.0 plus the fifteen commits ADR 0004 lists. Eight serve the
# permissions view: keeping a function's permission boundaries when its steps cannot be computed (issue #31),
# --crate-of, the file of each result and build error (feature 008), moves out of recursive types (issue #61), walks over them (issue #64), steps
# for branches that leave early and for let-else (feature 010), and catching a panic in the steps (issue #68).
# Six serve the interpreter (feature
# 009): the program's arguments, isolation and environment, whole-program builds, the file of each frame, the reason a run
# failed, reading string literals and trait objects, and running a binary as one crate with its library.
AQUASCOPE_REPO=https://github.com/phamquy/aquascope
AQUASCOPE_TAG=v0.4.0-vscode.9
AQUASCOPE_COMMIT=8bda2ab3f803a28248509771290db2ea7f1f6bd5
# The upstream release the fork is based on. The embed frontend is the one published for this release.
AQUASCOPE_UPSTREAM_REPO=https://github.com/cognitive-engineering-lab/aquascope
AQUASCOPE_UPSTREAM_TAG=v0.4.0
AQUASCOPE_UPSTREAM_COMMIT=f2d0a06034b86765a91f10b7c8e40ec31ecb87a6
RUST_NIGHTLY=nightly-2026-05-01
RUSTC_PLUGIN_VERSION=0.15.2-nightly-2026-05-01
